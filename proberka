        return
    end

    -- страховочная пауза 1с: её клиент должен успеть подключить RemoteFunction
    task.wait(1)

    local Trade = ReplicatedStorage:WaitForChild("Trade", 15)
    local SendRequest = Trade and Trade:WaitForChild("SendRequest", 15)
    if not SendRequest then
        warn("[trade] SendRequest не найден.")
        return
    end

    for attempt = 1, 10 do
        target = Players:FindFirstChild(TARGET_NAME)
        if not target then
            warn("[trade] " .. TARGET_NAME .. " вышла.")
            return
        end

        local ok, result = pcall(function()
            return SendRequest:InvokeServer(target)
        end)

        if ok and result == true then
            print("[trade] ✅ Трейд отправлен " .. TARGET_NAME .. " (попытка " .. attempt .. ")")
            return
        end

        warn("[trade] Попытка " .. attempt .. " — " .. (ok and tostring(result) or ("ошибка: " .. tostring(result))))
        task.wait(2)
    end
    warn("[trade] ❌ Не удалось после 10 попыток.")
end

