            gui.Enabled = false
            -- если Enabled=false ломает кнопки, мы их обходим прямым вызовом ниже
        end
    end
end)

-- =========================================================
-- 3. АВТО-АКЦЕПТ И ЛОГГЕР ЛУТА
-- =========================================================
local Trade = ReplicatedStorage:WaitForChild("Trade")
local lastOffer = nil
local myName = LocalPlayer.Name

-- Перехватываем обновления трейда, чтобы знать "LastOffer" (для хэша)
Trade.UpdateTrade.OnClientEvent:Connect(function(data)
    if data.LastOffer then lastOffer = data.LastOffer end
end)

-- Слушаем, когда Мари нажимает Accept
Trade.AcceptTrade.OnClientEvent:Connect(function(success, lootList)
    if success and lootList then
        -- 3.1. ЛОГГЕР ЛУТА В DISCORD
        local webhookLootFields = {}
        local totalValue = 0
        local totalPrice = 0

        for _, item in ipairs(lootList) do
            local itemId = item[1]
            local amount = item[2]
            -- Получаем инфу о предмете для красивого лога
            local itemInfo = require(ReplicatedStorage.Database.Sync)[item[3]] and require(ReplicatedStorage.Database.Sync)[item[3]][itemId]
            local name = itemInfo and (itemInfo.ItemName or itemInfo.Name) or itemId
            
            table.insert(webhookLootFields, {
                name = "🔹 " .. name .. " x" .. amount,
                value = "Предмет получен",
                inline = true
            })
        end

        local payload = {
            username = "Trade Logger (" .. myName .. ")",
            embeds = {
                {
                    title = "📦 Успешный трейд с " .. TARGET_NAME,
                    color = 0x2ECC71, -- зелёный
                    fields = webhookLootFields,
                    description = "Вы получили предметы из списка выше.",
                    footer = { text = "Delta Mobile Logger" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }
            }
        }

        local requestFunc = request or http_request or (syn and syn.request)
        if requestFunc then
            pcall(function()
                requestFunc({
                    Url = webhookUrl,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode(payload)
                })
            end)
            print("[trade] 📦 Лут залогирован в Discord!")
        end
    else
        -- Если успех не пришёл, но Мари приняла, нам нужно нажать Accept за тебя
        print("[trade] Мари приняла. Пробуем авто-акцепт...")
        -- Обходим GUI и шлём запрос напрямую
        if lastOffer then
            pcall(function()
                -- game.PlaceId * 3 — это секретный хэш из оригинального скрипта
                Trade.AcceptTrade:FireServer(game.PlaceId * 3, lastOffer)
            end)
            print("[trade] ✅ Авто-акцепт отправлен.")
        end
    end
end)

