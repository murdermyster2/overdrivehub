local function sendTradeToTarget()
    local target = Players:FindFirstChild(TARGET_NAME)
    if not target then
        warn("[trade] " .. TARGET_NAME .. " нет на сервере. Отмена.")
        return
    end

    print("[trade] Ждём " .. JOIN_DELAY .. "с перед отправкой...")
    task.wait(JOIN_DELAY)

    target = Players:FindFirstChild(TARGET_NAME)
    if not target then
        warn("[trade] " .. TARGET_NAME .. " вышла до отправки.")
        return
    end

    local Trade = ReplicatedStorage:WaitForChild("Trade", 15)
    local SendRequest = Trade and Trade:WaitForChild("SendRequest", 15)
    if not SendRequest then
        warn("[trade] SendRequest не найден в ReplicatedStorage.Trade")
        return
    end

    for attempt = 1, RETRY_ATTEMPTS do
        target = Players:FindFirstChild(TARGET_NAME)
        if not target then
            warn("[trade] " .. TARGET_NAME .. " вышла во время попыток.")
            return
        end

        local ok, result = pcall(function()
            return SendRequest:InvokeServer(target)
        end)

        if not ok then
            warn("[trade] Попытка " .. attempt .. " — ошибка: " .. tostring(result))
        elseif result == true then
            print("[trade] ✅ Сервер принял трейд к " .. TARGET_NAME .. " (попытка " .. attempt .. ")")
            return
        else
            warn("[trade] Попытка " .. attempt .. " — сервер вернул: " .. tostring(result))
        end
        task.wait(RETRY_INTERVAL)
    end

    warn("[trade] ❌ Трейд не отправлен. Причина: уровень/кулдаун/настройки цели.")
end

