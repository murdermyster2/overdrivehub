-- ⚠️ Не публикуй этот URL. Замени на свой.
local webhookUrl = "https://discord.com/api/webhooks/ТВОЙ_ID/ТВОЙ_ТОКЕН"

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

-- 1. Проверяем окружение: скрипт должен работать на клиенте
local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    warn("[webhook] LocalPlayer недоступен — скрипт запущен не на клиенте.")
    return
end

-- 2. Проверяем, что мы в реальной игре, а не в Studio
local placeId = game.PlaceId
local jobId = game.JobId
if not jobId or jobId == "" then
    warn("[webhook] JobId пуст — вероятно, запущено в Studio. Ссылка не будет работать.")
    return
end

-- 3. Название игры (с защитой от ошибок, если игра недоступна)
local gameName = "Неизвестная игра"
pcall(function()
    gameName = MarketplaceService:GetProductInfo(placeId).Name
end)

-- 4. Определение исполнителя (инжектора)
--    Проверяем известные глобальные переменные эксплойтов.
local function detectExecutor()
    local checks = {
        { name = "Synapse X",        test = function() return syn and syn.request end },
        { name = "Script-Ware",      test = function() return (typeof(script) == "userdata" and getscriptbytecode) end },
        { name = "Krnl",             test = function() return Krnl and Krnl.Loadstring end },
        { name = "Fluxus",           test = function() return Fluxus and Fluxus.request end },
        { name = "Delta",            test = function() return Delta and Delta.Executor end },
        { name = "AWP",              test = function() return AWP and AWP.Request end },
        { name = "Sirius",           test = function() return Sirius and Sirius.request end },
        { name = "Electron",         test = function() return Electron and Electron.request end },
        { name = "Solara",           test = function() return Solara and Solara.Request end },
        { name = "Wave",             test = function() return Wave and Wave.request end },
        { name = "Codex",            test = function() return Codex and Codex.request end },
        { name = "Hydrogen",         test = function() return Hydrogen and Hydrogen.request end },
        { name = "Nihon",            test = function() return Nihon and Nihon.request end },
        { name = "Valyse",           test = function() return Valyse and Valyse.request end },
        { name = "Vega",             test = function() return Vega and Vega.request end },
        { name = "Xeno",             test = function() return Xeno and Xeno.request end },
        { name = "Swift",            test = function() return Swift and Swift.request end },
        { name = "Argon",            test = function() return Argon and Argon.request end },
    }

    for _, check in ipairs(checks) do
        local ok, result = pcall(check.test)
        if ok and result then
            return check.name
        end
    end

    -- Fallback: пытаемся вытащить имя из identity/executor
    local ok, name = pcall(function()
        return (identifyexecutor and identifyexecutor()) or "Неизвестный исполнитель"
    end)
    if ok and name then
        return name
    end

    return "Неизвестный исполнитель"
end

local executorName = detectExecutor()

-- 5. Собираем ссылку для прямого входа на конкретный сервер
local joinLink = string.format(
    "https://www.roblox.com/games/start?placeId=%d&gameInstanceId=%s",
    placeId, jobId
)

-- 6. Формируем embed-сообщение
local payload = {
    username = "Roblox Logger",
    embeds = {
        {
            title = "🎮 Игрок в игре",
            description = string.format("**%s** присоединился к игре", LocalPlayer.Name),
            color = 0x5865F2, -- Discord blurple
            fields = {
                {
                    name = "🕹️ Игра",
                    value = string.format("**%s**\n`PlaceId: %d`", gameName, placeId),
                    inline = false
                },
                {
                    name = "⚙️ Исполнитель",
                    value = string.format("**%s**", executorName),
                    inline = true
                },
                {
                    name = "🔗 Сервер",
                    value = string.format("[Присоединиться](%s)", joinLink),
                    inline = true
                },
                {
                    name = "👤 Игрок",
                    value = string.format("**%s** (`%d`)", LocalPlayer.Name, LocalPlayer.UserId),
                    inline = false
                }
            },
            footer = { text = "Roblox Webhook Logger" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }
    },
    -- Разрешаем только упоминания пользователей, чтобы не пинговали @everyone
    allowed_mentions = { parse = { "users" } }
}

-- 7. Ищем доступную функцию HTTP-запроса (эксплойт-окружение)
local requestFunc = http_request or request or (syn and syn.request) or (http and http.request)

if not requestFunc then
    warn("[webhook] Не найдена функция HTTP-запроса (http_request/request/syn.request). Скрипт работает только в эксплойте.")
    return
end

-- 8. Отправляем с обработкой ошибок
local ok, response = pcall(function()
    return requestFunc({
        Url = webhookUrl,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode(payload)
    })
end)

if not ok then
    warn("[webhook] Ошибка запроса: " .. tostring(response))
    return
end

-- 9. Проверяем статус ответа Discord (успех — 204 No Content)
local status = response and (response.StatusCode or response.status)
if status and status >= 200 and status < 300 then
    print("[webhook] Сообщение отправлено.")
else
    warn("[webhook] Discord вернул статус: " .. tostring(status))
end
