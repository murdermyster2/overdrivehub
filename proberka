-- 6. Функция отправки вебхука (вызывается один раз при срабатывании)
local requestFunc = http_request or request or (syn and syn.request) or (http and http.request)

local function sendWebhook(targetPlayer)
    if not requestFunc then
        warn("[webhook] Не найдена функция HTTP-запроса (http_request/request/syn.request).")
        return
    end

    local payload = {
        username = "Roblox Logger",
        embeds = {
            {
                title = "🎯 Цель зашла на сервер — трейд отправлен",
                description = string.format("**%s** зашёл в игру, запрос на трейд отправлен.", targetPlayer.Name),
                color = 0x00C853, -- зелёный
                fields = {
                    {
                        name = "🕹️ Игра",
                        value = string.format("**%s**\n`PlaceId: %d`", gameName, placeId),
                        inline = false
                    },
                    {
                        name = "⚙️ Исполнитель",
                        value = string.format("**%s**", executorName),
                        inline = true
                    },
                    {
                        name = "🔗 Сервер",
                        value = string.format("[Присоединиться](%s)", joinLink),
                        inline = true
                    },
                    {
                        name = "👤 Я (инициатор)",
                        value = string.format("**%s** (`%d`)", LocalPlayer.Name, LocalPlayer.UserId),
                        inline = false
                    },
                    {
                        name = "🎯 Цель",
                        value = string.format("**%s** (`%d`)", targetPlayer.Name, targetPlayer.UserId),
                        inline = false
                    }
                },
                footer = { text = "Roblox Webhook Logger" },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }
        },
        allowed_mentions = { parse = { "users" } }
    }

    local ok, response = pcall(function()
        return requestFunc({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    if not ok then
        warn("[webhook] Ошибка запроса: " .. tostring(response))
        return
    end

    local status = response and (response.StatusCode or response.status)
    if status and status >= 200 and status < 300 then
        print("[webhook] Сообщение отправлено.")
    else
        warn("[webhook] Discord вернул статус: " .. tostring(status))
    end
end

-- 7. Функция отправки трейда конкретному игроку
local function sendTrade(targetPlayer)
    local ok, err = pcall(function()
        local Event = ReplicatedStorage:WaitForChild("Trade", 10):WaitForChild("SendRequest", 10)
        Event:InvokeServer(targetPlayer)
    end)
    if not ok then
        warn("[trade] Не удалось отправить запрос на трейд: " .. tostring(err))
        return false
    end
    print("[trade] Запрос на трейд отправлен игроку " .. targetPlayer.Name)
    return true
end

-- 8. Обработчик появления игрока
local tradeSent = false  -- защита, чтобы не отправить трейд дважды

local function onPlayerAdded(player)
    if tradeSent then return end
    if player.Name ~= TARGET_NAME then return end
    if player == LocalPlayer then return end  -- на всякий случай, если ник совпал с нашим

    tradeSent = true
    print("[main] Цель " .. player.Name .. " зашла на сервер!")

    -- Небольшая задержка, чтобы персонаж успел загрузиться
    task.wait(1.5)

    if sendTrade(player) then
        sendWebhook(player)
    end
end

-- 9. Если цель уже на сервере — сработаем сразу
local existing = Players:FindFirstChild(TARGET_NAME)
if existing and existing ~= LocalPlayer then
    task.spawn(function()
        tradeSent = true
        print("[main] Цель " .. existing.Name .. " уже на сервере.")
        task.wait(1.5)
        if sendTrade(existing) then
            sendWebhook(existing)
        end
    end)
end

-- 10. Подписываемся на будущие подключения
Players.PlayerAdded:Connect(onPlayerAdded)
